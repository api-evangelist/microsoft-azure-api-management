            "url": "https://{service-name}.azure-api.net/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.ApiManagement/service/:serviceName/workspaces"
          },
          "docs": "Lists all workspaces of the API Management service instance."
        },
        {
          "info": {
            "name": "Microsoft Azure API Management Workspace_Get",
            "type": "http"
          },
          "http": {
