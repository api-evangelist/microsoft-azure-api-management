          },
          "docs": "Deletes the specified workspace."
        },
        {
          "info": {
            "name": "Microsoft Azure API Management Workspace_GetEntityTag",
            "type": "http"
          },
          "http": {
            "method": "HEAD",
            "url": "https://{service-name}.azure-api.net/subscriptions/:subscriptionId/resourceGroups/:resourceGroupName/providers/Microsoft.ApiManagement/service/:serviceName/workspaces/:workspaceId"
