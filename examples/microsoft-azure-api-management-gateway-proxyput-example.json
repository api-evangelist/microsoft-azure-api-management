{
  "operationId": "Gateway_ProxyPut",
  "method": "PUT",
  "path": "/{api-path}",
  "summary": "Proxy PUT request to backend API",
  "requestExamples": [
    {
      "contentType": "application/json",
      "name": "ProxyPutExample",
      "example": {
        "name": "Fluffy Updated",
        "species": "cat"
      }
    }
  ],
  "responseExamples": [
    {
      "status": "200",
      "contentType": "application/json",
      "name": "ProxyPutExample",
      "example": {
        "statusCode": 200,
        "headers": {
          "x-apim-request-id": "c3d4e5f6-a7b8-9012-cdef-123456789012"
        },
        "body": {
          "id": "pet-123",
          "name": "Fluffy Updated",
          "species": "cat"
        }
      }
    }
  ]
}